<%!-- Hero Section --%>
<section class="relative bg-gradient-to-br from-pink-50 to-purple-50 pt-20">
  <div class="container mx-auto px-4 py-16 lg:py-24">
    <div class="max-w-4xl mx-auto text-center">
      <h1 class="text-4xl md:text-6xl font-bold mb-6 text-gray-900">
        Ironfolk Combat
      </h1>
      <h2 class="text-xl md:text-2xl text-pink-600 mb-8 font-medium">
        Wellington Longsword Club
      </h2>
      <p class="text-lg md:text-xl text-gray-700 mb-12 max-w-2xl mx-auto">
        A safe, inclusive space for LGBTQ+ folks and allies to discover Historical European Martial Arts through German longsword techniques.
      </p>

      <%!-- CTA Buttons --%>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <.link navigate={~p"/signup"} class="rainbow-button">
          Join Our Community
        </.link>
        <.link navigate={~p"/about"} class="secondary-button">
          Learn More
        </.link>
      </div>
    </div>
  </div>

  <%!-- Decorative rainbow gradient --%>
  <div class="absolute bottom-0 left-0 right-0 h-1 bg-gradient-to-r from-red-400 via-yellow-400 via-green-400 via-blue-400 via-indigo-400 to-purple-400">
  </div>
</section>

<%!-- Quick Info Section --%>
<section class="bg-white py-12">
  <div class="container mx-auto px-4">
    <div class="grid md:grid-cols-3 gap-8 text-center">
      <div class="space-y-3">
        <div class="w-16 h-16 bg-pink-100 rounded-full flex items-center justify-center mx-auto">
          <svg class="w-8 h-8 text-pink-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"
            >
            </path>
          </svg>
        </div>
        <h3 class="text-xl font-semibold text-gray-900">Training Times</h3>
        <p class="text-gray-600">Every Thursday Evening and Saturday day</p>
      </div>

      <div class="space-y-3">
        <div class="w-16 h-16 bg-pink-100 rounded-full flex items-center justify-center mx-auto">
          <svg class="w-8 h-8 text-pink-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"
            >
            </path>
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"
            >
            </path>
          </svg>
        </div>
        <h3 class="text-xl font-semibold text-gray-900">Safe Space</h3>
        <p class="text-gray-600">Located in Wellington with easy transport links</p>
      </div>

      <div class="space-y-3">
        <div class="w-16 h-16 bg-pink-100 rounded-full flex items-center justify-center mx-auto">
          <svg class="w-8 h-8 text-pink-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"
            >
            </path>
          </svg>
        </div>
        <h3 class="text-xl font-semibold text-gray-900">All Welcome</h3>
        <p class="text-gray-600">No experience required - beginners and allies welcome</p>
      </div>
    </div>
  </div>
</section>

<%!-- What is HEMA Section --%>
<section class="bg-pink-25 py-16">
  <div class="container mx-auto px-4 text-center">
    <h2 class="text-3xl font-bold text-gray-900 mb-8">What is HEMA?</h2>
    <p class="text-lg text-gray-700 max-w-3xl mx-auto mb-8">
      Historical European Martial Arts (HEMA) is the study and practice of historical European fighting techniques.
      At Ironfolk Combat, we create an inclusive, supportive environment where LGBTQ+ folks and allies can explore
      these fascinating martial arts together, building both skill and community.
    </p>
    <.link
      navigate={~p"/about"}
      class="text-pink-600 hover:text-pink-800 font-semibold transition-colors"
    >
      Learn more about our approach →
    </.link>
  </div>
</section>
