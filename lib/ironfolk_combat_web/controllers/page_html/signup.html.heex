<%!-- Hero Section --%>
<section class="relative bg-gradient-to-br from-pink-50 to-purple-50 pt-20">
  <div class="container mx-auto px-4 py-16 lg:py-24">
    <div class="max-w-4xl mx-auto text-center">
      <h1 class="text-4xl md:text-6xl font-bold mb-6 text-gray-900">Join Ironfolk Combat</h1>

      <p class="text-lg md:text-xl text-gray-700 mb-12 max-w-2xl mx-auto">
        Ready to begin your HEMA journey? Sign up for your three free sessions!
      </p>
    </div>
  </div>
  <%!-- Decorative rainbow gradient --%>
  <div class="absolute bottom-0 left-0 right-0 h-1 bg-gradient-to-r from-red-400 via-yellow-400 via-green-400 via-blue-400 via-indigo-400 to-purple-400">
  </div>
</section>

<div class="min-h-screen bg-white">
  <div class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="bg-white border border-pink-200 rounded-lg shadow-lg p-8">
      <%= if assigns[:errors] do %>
        <div class="mb-6 p-4 bg-red-50 border border-red-200 rounded-md">
          <div class="flex">
            <svg class="w-5 h-5 text-red-400 mr-2 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
              <path
                fill-rule="evenodd"
                d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z"
                clip-rule="evenodd"
              >
              </path>
            </svg>
            <div>
              <h3 class="text-sm font-medium text-red-800">
                Please correct the following errors:
              </h3>

              <ul class="mt-2 text-sm text-red-700">
                <%= for error <- @errors do %>
                  <li>{error}</li>
                <% end %>
              </ul>
            </div>
          </div>
        </div>
      <% end %>

      <form action={~p"/signup"} method="post" class="space-y-6">
        <input type="hidden" name="_csrf_token" value={get_csrf_token()} />
        <!-- Personal Information -->
        <div class="border-b border-gray-200 pb-6">
          <h2 class="text-lg font-semibold text-gray-900 mb-4">Personal Information</h2>

          <div class="grid md:grid-cols-2 gap-4">
            <div>
              <label for="first_name" class="block text-sm font-medium text-gray-700 mb-2">
                First Name *
              </label>
              <input
                type="text"
                id="first_name"
                name="signup[first_name]"
                required
                class="w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-2 focus:ring-pink-500 focus:border-pink-500"
              />
            </div>

            <div>
              <label for="last_name" class="block text-sm font-medium text-gray-700 mb-2">
                Last Name *
              </label>
              <input
                type="text"
                id="last_name"
                name="signup[last_name]"
                required
                class="w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-2 focus:ring-pink-500 focus:border-pink-500"
              />
            </div>
          </div>
        </div>
        <!-- Contact Information -->
        <div class="border-b border-gray-200 pb-6">
          <h2 class="text-lg font-semibold text-gray-900 mb-4">Contact Information</h2>

          <div class="space-y-4">
            <div>
              <label for="email" class="block text-sm font-medium text-gray-700 mb-2">
                Email Address *
              </label>
              <input
                type="email"
                id="email"
                name="signup[email]"
                required
                class="w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-2 focus:ring-pink-500 focus:border-pink-500"
              />
            </div>

            <div>
              <label for="phone" class="block text-sm font-medium text-gray-700 mb-2">
                Phone Number *
              </label>
              <input
                type="tel"
                id="phone"
                name="signup[phone]"
                required
                class="w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-2 focus:ring-pink-500 focus:border-pink-500"
              />
            </div>

            <div>
              <label for="age" class="block text-sm font-medium text-gray-700 mb-2">Age *</label>
              <select
                id="age"
                name="signup[age_range]"
                required
                class="w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-2 focus:ring-pink-500 focus:border-pink-500"
              >
                <option value="">Select age range</option>

                <option value="under_18">Under 18</option>

                <option value="18_25">18-25</option>

                <option value="26_35">26-35</option>

                <option value="36_45">36-45</option>

                <option value="46_55">46-55</option>

                <option value="over_55">Over 55</option>
              </select>
            </div>
          </div>
        </div>
        <!-- Experience & Emergency Contact -->
        <div class="border-b border-gray-200 pb-6">
          <h2 class="text-lg font-semibold text-gray-900 mb-4">Experience & Safety</h2>

          <div class="space-y-4">
            <div>
              <label for="experience" class="block text-sm font-medium text-gray-700 mb-2">
                Previous HEMA/Martial Arts Experience
              </label>
              <select
                id="experience"
                name="signup[experience_level]"
                class="w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-2 focus:ring-pink-500 focus:border-pink-500"
              >
                <option value="none">Complete beginner</option>

                <option value="some_martial_arts">Some martial arts experience</option>

                <option value="some_hema">Some HEMA experience</option>

                <option value="experienced_hema">Experienced HEMA practitioner</option>
              </select>
            </div>

            <div>
              <label
                for="emergency_contact_name"
                class="block text-sm font-medium text-gray-700 mb-2"
              >
                Emergency Contact Name *
              </label>
              <input
                type="text"
                id="emergency_contact_name"
                name="signup[emergency_contact_name]"
                required
                class="w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-2 focus:ring-pink-500 focus:border-pink-500"
              />
            </div>

            <div>
              <label
                for="emergency_contact_phone"
                class="block text-sm font-medium text-gray-700 mb-2"
              >
                Emergency Contact Phone *
              </label>
              <input
                type="tel"
                id="emergency_contact_phone"
                name="signup[emergency_contact_phone]"
                required
                class="w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-2 focus:ring-pink-500 focus:border-pink-500"
              />
            </div>

            <div>
              <label for="medical_conditions" class="block text-sm font-medium text-gray-700 mb-2">
                Medical Conditions or Injuries (Optional)
              </label>
              <textarea
                id="medical_conditions"
                name="signup[medical_conditions]"
                rows="3"
                placeholder="Please list any medical conditions, injuries, or physical limitations we should be aware of..."
                class="w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-2 focus:ring-pink-500 focus:border-pink-500"
              ></textarea>
            </div>
          </div>
        </div>
        <!-- Agreement & Submit -->
        <div class="space-y-4">
          <div class="flex items-start">
            <input
              type="checkbox"
              id="waiver_agreement"
              name="signup[waiver_agreement]"
              required
              class="mt-1 rounded border-gray-300 text-pink-600 focus:ring-pink-500"
            />
            <label for="waiver_agreement" class="ml-3 text-sm text-gray-700">
              I understand that HEMA training involves physical activity and potential risk of injury. I agree to follow all safety protocols and acknowledge that I participate at my own risk. I will complete a formal waiver before my first training session. *
            </label>
          </div>

          <div class="flex items-start">
            <input
              type="checkbox"
              id="contact_agreement"
              name="signup[contact_agreement]"
              required
              class="mt-1 rounded border-gray-300 text-pink-600 focus:ring-pink-500"
            />
            <label for="contact_agreement" class="ml-3 text-sm text-gray-700">
              I agree to be contacted by Ironfolk Combat regarding training schedules, events, and club information. *
            </label>
          </div>

          <button type="submit" class="w-full rainbow-button text-lg py-3">
            Submit Application
          </button>
        </div>
      </form>
    </div>
    <!-- Information Box -->
    <div class="mt-8 bg-gradient-to-r from-pink-50 to-purple-50 border border-pink-200 rounded-lg p-6">
      <h3 class="text-lg font-semibold text-gray-900 mb-3">What happens next?</h3>

      <ul class="space-y-2 text-gray-700">
        <li class="flex items-start">
          <span class="text-pink-600 mr-2">1.</span>
          We'll send you an email with all the information about the club's training times and communities
        </li>

        <li class="flex items-start">
          <span class="text-pink-600 mr-2">2.</span>
          Show up to the lesson and get familiar with our training gear and practices
        </li>

        <li class="flex items-start">
          <span class="text-pink-600 mr-2">3.</span> Begin your HEMA journey!
        </li>
      </ul>
    </div>
  </div>
</div>
