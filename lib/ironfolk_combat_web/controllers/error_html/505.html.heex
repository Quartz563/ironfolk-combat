<%!-- Hero Section --%>
<section class="relative bg-gradient-to-br from-pink-50 to-purple-50 pt-20">
  <div class="container mx-auto px-4 py-16 lg:py-24">
    <div class="max-w-4xl mx-auto text-center">
      <div class="mb-8">
        <span class="text-8xl md:text-9xl font-bold bg-gradient-to-r from-pink-600 to-purple-600 bg-clip-text text-transparent">
          500
        </span>
      </div>

      <h1 class="text-4xl md:text-5xl font-bold mb-6 text-gray-900">
        Internal Server Error
      </h1>

      <p class="text-lg md:text-xl text-gray-700 mb-12 max-w-2xl mx-auto">
        Oops! Something went wrong on our end. Our swords got tangled up in the server room.
      </p>
    </div>
  </div>

  <%!-- Decorative rainbow gradient --%>
  <div class="absolute bottom-0 left-0 right-0 h-1 bg-gradient-to-r from-red-400 via-yellow-400 via-green-400 via-blue-400 via-indigo-400 to-purple-400">
  </div>
</section>

<div class="min-h-screen bg-white">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <%!-- Error Information --%>
    <div class="bg-gradient-to-r from-pink-50 to-purple-50 border-2 border-pink-200 rounded-lg p-8 mb-8">
      <div class="flex items-start">
        <div class="flex-shrink-0">
          <svg
            class="w-12 h-12 text-pink-600"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"
            >
            </path>
          </svg>
        </div>
        <div class="ml-6">
          <h2 class="text-2xl font-bold text-gray-900 mb-4">What happened?</h2>
          <p class="text-gray-700 mb-4">
            We encountered an unexpected error while processing your request. Don't worry - it's not your fault!
            Our team has been notified and we'll look into it right away.
          </p>
          <p class="text-gray-700">
            In the meantime, you can try:
          </p>
          <ul class="mt-3 space-y-2 text-gray-700">
            <li class="flex items-start">
              <span class="text-pink-600 mr-2">•</span> Refreshing the page
            </li>
            <li class="flex items-start">
              <span class="text-pink-600 mr-2">•</span> Going back to the previous page
            </li>
            <li class="flex items-start">
              <span class="text-pink-600 mr-2">•</span> Returning to the homepage
            </li>
          </ul>
        </div>
      </div>
    </div>

    <%!-- Quick Links --%>
    <div class="grid md:grid-cols-3 gap-4 mb-8">
      <.link
        navigate={~p"/"}
        class="flex items-center justify-center p-4 bg-white rounded-lg border-2 border-pink-200 hover:border-pink-500 transition-colors"
      >
        <svg
          class="w-5 h-5 text-pink-600 mr-2"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"
          >
          </path>
        </svg>
        <span class="font-semibold text-gray-900">Return Home</span>
      </.link>

      <.link
        navigate={~p"/contact"}
        class="flex items-center justify-center p-4 bg-white rounded-lg border-2 border-pink-200 hover:border-pink-500 transition-colors"
      >
        <svg
          class="w-5 h-5 text-pink-600 mr-2"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M3 8l7.89 4.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
          >
          </path>
        </svg>
        <span class="font-semibold text-gray-900">Contact Us</span>
      </.link>

      <button
        onclick="window.history.back()"
        class="flex items-center justify-center p-4 bg-white rounded-lg border-2 border-pink-200 hover:border-pink-500 transition-colors"
      >
        <svg
          class="w-5 h-5 text-pink-600 mr-2"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M10 19l-7-7m0 0l7-7m-7 7h18"
          >
          </path>
        </svg>
        <span class="font-semibold text-gray-900">Go Back</span>
      </button>
    </div>

    <%!-- Supportive message --%>
    <div class="text-center">
      <div class="bg-white border-2 border-pink-200 rounded-lg p-8 inline-block">
        <svg
          class="w-16 h-16 mx-auto mb-4 text-pink-400"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"
          >
          </path>
        </svg>
        <p class="text-gray-600 text-sm italic mb-2">
          "A momentary setback in the bout - we'll have this resolved shortly!"
        </p>
        <p class="text-gray-500 text-xs">
          If this problem persists, please let us know via the contact page.
        </p>
      </div>
    </div>
  </div>
</div>
