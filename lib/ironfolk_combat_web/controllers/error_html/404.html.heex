<%!-- Hero Section --%>
<section class="relative bg-gradient-to-br from-pink-50 to-purple-50 pt-20">
  <div class="container mx-auto px-4 py-16 lg:py-24">
    <div class="max-w-4xl mx-auto text-center">
      <div class="mb-8">
        <span class="text-8xl md:text-9xl font-bold bg-gradient-to-r from-pink-600 to-purple-600 bg-clip-text text-transparent">
          404
        </span>
      </div>

      <h1 class="text-4xl md:text-5xl font-bold mb-6 text-gray-900">
        Page Not Found
      </h1>

      <p class="text-lg md:text-xl text-gray-700 mb-12 max-w-2xl mx-auto">
        Looks like this page got disarmed in a bout! The page you're looking for doesn't exist or has been moved.
      </p>
    </div>
  </div>

  <%!-- Decorative rainbow gradient --%>
  <div class="absolute bottom-0 left-0 right-0 h-1 bg-gradient-to-r from-red-400 via-yellow-400 via-green-400 via-blue-400 via-indigo-400 to-purple-400">
  </div>
</section>

<div class="min-h-screen bg-white">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <%!-- Helpful Suggestions --%>
    <div class="bg-gradient-to-r from-pink-50 to-purple-50 border-2 border-pink-200 rounded-lg p-8 mb-8">
      <h2 class="text-2xl font-bold text-gray-900 mb-6 text-center">
        Where would you like to go?
      </h2>

      <div class="grid md:grid-cols-2 gap-4">
        <.link
          navigate={~p"/"}
          class="flex items-center p-4 bg-white rounded-lg border-2 border-pink-200 hover:border-pink-500 transition-colors group"
        >
          <div class="bg-pink-100 rounded-full p-3 mr-4 group-hover:bg-pink-200 transition-colors">
            <svg
              class="w-6 h-6 text-pink-600"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"
              >
              </path>
            </svg>
          </div>
          <div>
            <h3 class="font-bold text-gray-900">Home</h3>
            <p class="text-sm text-gray-600">Return to the homepage</p>
          </div>
        </.link>

        <.link
          navigate={~p"/signup"}
          class="flex items-center p-4 bg-white rounded-lg border-2 border-pink-200 hover:border-pink-500 transition-colors group"
        >
          <div class="bg-purple-100 rounded-full p-3 mr-4 group-hover:bg-purple-200 transition-colors">
            <svg
              class="w-6 h-6 text-purple-600"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"
              >
              </path>
            </svg>
          </div>
          <div>
            <h3 class="font-bold text-gray-900">Join Us</h3>
            <p class="text-sm text-gray-600">Sign up for free trial sessions</p>
          </div>
        </.link>

        <.link
          navigate={~p"/events"}
          class="flex items-center p-4 bg-white rounded-lg border-2 border-pink-200 hover:border-pink-500 transition-colors group"
        >
          <div class="bg-blue-100 rounded-full p-3 mr-4 group-hover:bg-blue-200 transition-colors">
            <svg
              class="w-6 h-6 text-blue-600"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"
              >
              </path>
            </svg>
          </div>
          <div>
            <h3 class="font-bold text-gray-900">Events</h3>
            <p class="text-sm text-gray-600">Check upcoming events</p>
          </div>
        </.link>

        <.link
          navigate={~p"/contact"}
          class="flex items-center p-4 bg-white rounded-lg border-2 border-pink-200 hover:border-pink-500 transition-colors group"
        >
          <div class="bg-green-100 rounded-full p-3 mr-4 group-hover:bg-green-200 transition-colors">
            <svg
              class="w-6 h-6 text-green-600"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M3 8l7.89 4.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
              >
              </path>
            </svg>
          </div>
          <div>
            <h3 class="font-bold text-gray-900">Contact</h3>
            <p class="text-sm text-gray-600">Get in touch with us</p>
          </div>
        </.link>
      </div>
    </div>

    <%!-- Fun HEMA-themed message --%>
    <div class="text-center">
      <div class="bg-white border-2 border-pink-200 rounded-lg p-8 inline-block">
        <svg
          class="w-16 h-16 mx-auto mb-4 text-pink-400"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
          >
          </path>
        </svg>
        <p class="text-gray-600 text-sm italic">
          "Even the best fencers miss their target sometimes. Let's help you find your way back on guard!"
        </p>
      </div>
    </div>
  </div>
</div>
