<%!-- Hero Section --%>
<.flash_group flash={@flash} />
<section class="relative bg-gradient-to-br from-pink-50 to-purple-50 dark:from-gray-900 dark:to-gray-800 pt-20">
  <div class="container mx-auto px-4 py-16 lg:py-24">
    <div class="max-w-4xl mx-auto text-center">
      <h1 class="text-4xl md:text-6xl font-bold mb-6 text-gray-900 dark:text-white">
        Membership Payment
      </h1>

      <p class="text-lg md:text-xl text-gray-700 dark:text-gray-300 mb-12 max-w-2xl mx-auto">
        Pay your Ironfolk Combat membership fees securely with Stripe
      </p>
    </div>
  </div>

  <div class="absolute bottom-0 left-0 right-0 h-1 bg-gradient-to-r from-red-400 via-yellow-400 via-green-400 via-blue-400 via-indigo-400 to-purple-400">
  </div>
</section>

<div class="min-h-screen bg-white dark:bg-gray-900 py-12">
  <div class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8">
    <%= if @step == :enter_ifn do %>
      <%!-- Step 1: Enter IFN --%>
      <div class="bg-gradient-to-br from-pink-50 to-purple-50 dark:from-gray-800 dark:to-gray-700 rounded-lg shadow-lg p-8">
        <h2 class="text-2xl font-bold text-gray-900 dark:text-white mb-6">
          Enter Your Ironfolk ID
        </h2>

        <p class="text-gray-700 dark:text-gray-300 mb-6">
          Please enter your Ironfolk ID Number (IFN) to proceed with your membership payment.
          Your IFN was provided when your signup was approved.
        </p>

        <form phx-submit="lookup_member" class="space-y-6">
          <div>
            <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
              Ironfolk ID Number (e.g., IFN-0001)
            </label>
            <input
              type="text"
              name="ifn"
              value={@ifn}
              phx-change="update_ifn"
              placeholder="IFN-XXXX"
              required
              class="w-full px-4 py-3 text-lg font-mono border border-gray-300 dark:border-gray-600 rounded-lg shadow-sm focus:outline-none focus:ring-2 focus:ring-pink-500 focus:border-pink-500 dark:bg-gray-700 dark:text-white uppercase"
            />
          </div>
          <button type="submit" class="w-full rainbow-button text-lg py-3">Continue</button>
        </form>

        <div class="mt-8 pt-6 border-t border-gray-200 dark:border-gray-700">
          <h3 class="text-sm font-semibold text-gray-900 dark:text-white mb-3">
            Don't have an Ironfolk ID?
          </h3>

          <p class="text-sm text-gray-700 dark:text-gray-300 mb-4">
            Your IFN is provided when your signup is approved by our team. If you haven't received your IFN yet:
          </p>

          <ul class="text-sm text-gray-700 dark:text-gray-300 space-y-2 mb-4">
            <li class="flex items-start">
              <span class="text-pink-600 dark:text-pink-400 mr-2">•</span>
              <span>Check your email for your welcome message</span>
            </li>

            <li class="flex items-start">
              <span class="text-pink-600 dark:text-pink-400 mr-2">•</span>
              <span>Contact us if you can't find your IFN</span>
            </li>

            <li class="flex items-start">
              <span class="text-pink-600 dark:text-pink-400 mr-2">•</span>
              <span>
                New members can
                <.link
                  navigate={~p"/signup"}
                  class="text-pink-600 dark:text-pink-400 hover:underline"
                >
                  sign up here
                </.link>
              </span>
            </li>
          </ul>
        </div>
      </div>
    <% else %>
      <%!-- Step 2: Confirm Details and Select Membership --%>
      <div class="bg-gradient-to-br from-pink-50 to-purple-50 dark:from-gray-800 dark:to-gray-700 rounded-lg shadow-lg p-8">
        <h2 class="text-2xl font-bold text-gray-900 dark:text-white mb-6">
          Confirm Your Details
        </h2>
        <%!-- Member Info --%>
        <div class="bg-white dark:bg-gray-800 rounded-lg p-6 mb-6 border border-gray-200 dark:border-gray-700">
          <div class="flex items-start justify-between mb-4">
            <div>
              <h3 class="text-lg font-semibold text-gray-900 dark:text-white">
                {@member.first_name} {@member.last_name}
              </h3>

              <p class="text-sm text-gray-600 dark:text-gray-400">
                IFN:
                <span class="font-mono font-bold text-pink-600 dark:text-pink-400">
                  {@member.ifn}
                </span>
              </p>
            </div>

            <%= if Members.membership_active?(@member) do %>
              <span class="px-3 py-1 rounded-full text-xs font-semibold bg-green-100 text-green-800 dark:bg-green-900/30 dark:text-green-400">
                ACTIVE
              </span>
            <% else %>
              <span class="px-3 py-1 rounded-full text-xs font-semibold bg-yellow-100 text-yellow-800 dark:bg-yellow-900/30 dark:text-yellow-400">
                EXPIRED
              </span>
            <% end %>
          </div>

          <div class="space-y-2 text-sm">
            <p class="text-gray-700 dark:text-gray-300">
              <span class="font-medium">Email:</span> {@member.email}
            </p>

            <%= if @member.membership_expires_at do %>
              <p class="text-gray-700 dark:text-gray-300">
                <span class="font-medium">Current Expiry:</span> {Date.to_string(
                  @member.membership_expires_at
                )}
              </p>
            <% end %>
          </div>
        </div>
        <%!-- Membership Type Selection --%>
        <div class="mb-6">
          <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-4">
            Select Membership Type
          </h3>

          <div class="space-y-3">
            <%!-- Standard Membership --%>
            <label class={"cursor-pointer block p-4 rounded-lg border-2 transition-all #{if @membership_type == "regular_monthly", do: "border-pink-500 bg-pink-50 dark:bg-pink-900/20", else: "border-gray-200 dark:border-gray-700 hover:border-pink-300"}"}>
              <input
                type="radio"
                name="membership_type"
                value="regular_monthly"
                checked={@membership_type == "regular_monthly"}
                phx-click="select_membership_type"
                phx-value-type="regular_monthly"
                class="sr-only"
              />
              <div class="flex items-center justify-between">
                <div>
                  <p class="font-semibold text-gray-900 dark:text-white">Standard Membership</p>

                  <p class="text-sm text-gray-600 dark:text-gray-400">One Month Membership</p>
                </div>

                <p class="text-2xl font-bold text-pink-600 dark:text-pink-400">$60</p>
              </div>
            </label>
             <%!-- Quaterly Membership --%>
            <label class={"cursor-pointer block p-4 rounded-lg border-2 transition-all #{if @membership_type == "regular_quarterly", do: "border-pink-500 bg-pink-50 dark:bg-pink-900/20", else: "border-gray-200 dark:border-gray-700 hover:border-pink-300"}"}>
              <input
                type="radio"
                name="membership_type"
                value="regular_quarterly"
                checked={@membership_type == "regular_quarterly"}
                phx-click="select_membership_type"
                phx-value-type="regular_quarterly"
                class="sr-only"
              />
              <div class="flex items-center justify-between">
                <div>
                  <p class="font-semibold text-gray-900 dark:text-white">Quaterly Membership</p>

                  <p class="text-sm text-gray-600 dark:text-gray-400">Three Month Membership</p>
                </div>

                <p class="text-2xl font-bold text-pink-600 dark:text-pink-400">$170</p>
              </div>
            </label>
             <%!-- Yearly Membership --%>
            <label class={"cursor-pointer block p-4 rounded-lg border-2 transition-all #{if @membership_type == "regular_yearly", do: "border-pink-500 bg-pink-50 dark:bg-pink-900/20", else: "border-gray-200 dark:border-gray-700 hover:border-pink-300"}"}>
              <input
                type="radio"
                name="membership_type"
                value="regular_yearly"
                checked={@membership_type == "regular_yearly"}
                phx-click="select_membership_type"
                phx-value-type="regular_yearly"
                class="sr-only"
              />
              <div class="flex items-center justify-between">
                <div>
                  <p class="font-semibold text-gray-900 dark:text-white">Yearly Membership</p>

                  <p class="text-sm text-gray-600 dark:text-gray-400">One Year Membership</p>
                </div>

                <p class="text-2xl font-bold text-pink-600 dark:text-pink-400">$660</p>
              </div>
            </label>
             <%!-- Concession Membership --%>
            <label class={"cursor-pointer block p-4 rounded-lg border-2 transition-all #{if @membership_type == "hardship_monthly", do: "border-pink-500 bg-pink-50 dark:bg-pink-900/20", else: "border-gray-200 dark:border-gray-700 hover:border-pink-300"}"}>
              <input
                type="radio"
                name="membership_type"
                value="hardship_monthly"
                checked={@membership_type == "hardship_monthly"}
                phx-click="select_membership_type"
                phx-value-type="hardship_monthly"
                class="sr-only"
              />
              <div class="flex items-center justify-between">
                <div>
                  <p class="font-semibold text-gray-900 dark:text-white">Concession Membership</p>

                  <p class="text-sm text-gray-600 dark:text-gray-400">
                    One Month - Unwaged, Hardship or Student
                  </p>
                </div>

                <p class="text-2xl font-bold text-pink-600 dark:text-pink-400">$25</p>
              </div>
            </label>
          </div>
        </div>
        <%!-- Actions --%>
        <div class="flex space-x-4">
          <button
            type="button"
            phx-click="back"
            class="flex-1 secondary-button py-3"
            disabled={@loading}
          >
            Back
          </button>
          <button
            type="button"
            phx-click="proceed_to_payment"
            class="flex-1 rainbow-button py-3"
            disabled={@loading}
          >
            <%= if @loading do %>
              <span class="flex items-center justify-center">
                <svg class="animate-spin h-5 w-5 mr-2" fill="none" viewBox="0 0 24 24">
                  <circle
                    class="opacity-25"
                    cx="12"
                    cy="12"
                    r="10"
                    stroke="currentColor"
                    stroke-width="4"
                  >
                  </circle>

                  <path
                    class="opacity-75"
                    fill="currentColor"
                    d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"
                  >
                  </path>
                </svg>
                Processing...
              </span>
            <% else %>
              Proceed to Payment
            <% end %>
          </button>
        </div>
        <%!-- Security Notice --%>
        <div class="mt-6 flex items-start p-4 bg-blue-50 dark:bg-blue-900/20 border border-blue-200 dark:border-blue-800 rounded-lg">
          <svg
            class="w-5 h-5 text-blue-600 dark:text-blue-400 mt-0.5 mr-3 flex-shrink-0"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"
            >
            </path>
          </svg>
          <div class="text-sm text-gray-700 dark:text-gray-300">
            <p class="font-semibold mb-1">Secure Payment</p>

            <p>
              Your payment will be processed securely through Stripe. You'll receive an automatic receipt via email.
            </p>
          </div>
        </div>
      </div>
    <% end %>
  </div>
</div>
