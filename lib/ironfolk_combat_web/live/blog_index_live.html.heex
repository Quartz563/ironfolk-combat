<.flash_group flash={@flash} />
<%!-- Hero Section --%>
<section class="relative bg-gradient-to-br from-pink-50 to-purple-50 pt-20">
  <div class="container mx-auto px-4 py-16 lg:py-24">
    <div class="max-w-4xl mx-auto text-center">
      <h1 class="text-4xl md:text-6xl font-bold mb-6 text-gray-900">Blog</h1>

      <p class="text-lg md:text-xl text-gray-700 mb-12 max-w-2xl mx-auto">
        News, tutorials, insights and other general ramblings from the Ironfolk Combat community
      </p>
    </div>
  </div>
  <%!-- Decorative rainbow gradient --%>
  <div class="absolute bottom-0 left-0 right-0 h-1 bg-gradient-to-r from-red-400 via-yellow-400 via-green-400 via-blue-400 via-indigo-400 to-purple-400">
  </div>
</section>

<div class="min-h-screen bg-white">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <%= if Enum.empty?(@posts) do %>
      <div class="text-center py-12">
        <svg
          class="w-16 h-16 text-gray-400 mx-auto mb-4"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z"
          >
          </path>
        </svg>
        <p class="text-gray-600 text-lg">No blog posts yet. Check back soon!</p>
      </div>
    <% else %>
      <div class="space-y-8" phx-update="prepend" id="blog-posts">
        <%= for post <- @posts do %>
          <article
            id={"post-#{post.id}"}
            class="bg-white border border-pink-200 rounded-lg shadow-sm hover:shadow-md transition-shadow overflow-hidden"
          >
            <div class="p-6">
              <div class="flex items-center gap-2 mb-3">
                <span class="text-sm text-gray-600">
                  {Calendar.strftime(post.published_at || post.inserted_at, "%B %d, %Y")}
                </span>
                <%= if post.author_name do %>
                  <span class="text-gray-400">•</span>
                  <span class="text-sm text-gray-600">By {post.author_name}</span>
                <% end %>
              </div>

              <h2 class="text-2xl font-bold text-gray-900 mb-3 hover:text-pink-600 transition-colors">
                <.link navigate={~p"/blog/#{post.slug}"}>{post.title}</.link>
              </h2>

              <%= if post.excerpt do %>
                <p class="text-gray-700 mb-4">{post.excerpt}</p>
              <% else %>
                <p class="text-gray-700 mb-4">
                  {String.slice(post.content, 0..200)}{if String.length(post.content) > 200,
                    do: "..."}
                </p>
              <% end %>

              <.link
                navigate={~p"/blog/#{post.slug}"}
                class="text-pink-600 hover:text-pink-800 font-semibold transition-colors"
              >
                Read more →
              </.link>
            </div>
          </article>
        <% end %>
      </div>
    <% end %>
  </div>
</div>
