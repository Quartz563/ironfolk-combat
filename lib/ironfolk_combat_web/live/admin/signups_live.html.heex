<.flash_group flash={@flash} />
<div class="min-h-screen bg-gray-50">
  <!-- Admin Header -->
  <header class="bg-white shadow-sm border-b-4 border-pink-500">
    <div class="container mx-auto px-4 py-4">
      <div class="flex items-center justify-between">
        <div class="flex items-center space-x-4">
          <.link navigate={~p"/admin/dashboard"} class="text-pink-600 hover:text-pink-800">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M10 19l-7-7m0 0l7-7m-7 7h18"
              >
              </path>
            </svg>
          </.link>
          <div>
            <h1 class="text-2xl font-bold text-gray-900">Manage Signups</h1>

            <p class="text-sm text-gray-600">{length(@signups)} signups</p>
          </div>
        </div>
        <.link href={~p"/admin/logout"} method="delete" class="secondary-button">Logout</.link>
      </div>
    </div>
  </header>
  <!-- Main Content -->
  <main class="container mx-auto px-4 py-8">
    <!-- Filters -->
    <div class="bg-white rounded-lg shadow-md p-4 mb-6">
      <div class="flex items-center space-x-4">
        <span class="text-sm font-medium text-gray-700">Filter by status:</span>
        <button
          phx-click="filter"
          phx-value-status="all"
          class={"px-4 py-2 rounded-md text-sm font-medium transition-colors #{if @filter == "all", do: "bg-pink-600 text-white", else: "bg-gray-200 text-gray-700 hover:bg-gray-300"}"}
        >
          All
        </button>
        <button
          phx-click="filter"
          phx-value-status="pending"
          class={"px-4 py-2 rounded-md text-sm font-medium transition-colors #{if @filter == "pending", do: "bg-yellow-600 text-white", else: "bg-gray-200 text-gray-700 hover:bg-gray-300"}"}
        >
          Pending
        </button>
        <button
          phx-click="filter"
          phx-value-status="approved"
          class={"px-4 py-2 rounded-md text-sm font-medium transition-colors #{if @filter == "approved", do: "bg-green-600 text-white", else: "bg-gray-200 text-gray-700 hover:bg-gray-300"}"}
        >
          Approved
        </button>
        <button
          phx-click="filter"
          phx-value-status="contacted"
          class={"px-4 py-2 rounded-md text-sm font-medium transition-colors #{if @filter == "contacted", do: "bg-blue-600 text-white", else: "bg-gray-200 text-gray-700 hover:bg-gray-300"}"}
        >
          Contacted
        </button>
      </div>
    </div>
    <!-- Signups List -->
    <%= if Enum.empty?(@signups) do %>
      <div class="bg-white rounded-lg shadow-md p-12 text-center">
        <svg
          class="w-16 h-16 text-gray-400 mx-auto mb-4"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M20 13V6a2 2 0 00-2-2H6a2 2 0 00-2 2v7m16 0v5a2 2 0 01-2 2H6a2 2 0 01-2-2v-5m16 0h-2.586a1 1 0 00-.707.293l-2.414 2.414a1 1 0 01-.707.293h-3.172a1 1 0 01-.707-.293l-2.414-2.414A1 1 0 006.586 13H4"
          >
          </path>
        </svg>
        <p class="text-gray-600 text-lg">No signups found</p>
      </div>
    <% else %>
      <div class="space-y-4">
        <%= for signup <- @signups do %>
          <div class="bg-white rounded-lg shadow-md overflow-hidden hover:shadow-lg transition-shadow">
            <div class="p-6">
              <div class="flex items-start justify-between mb-4">
                <div class="flex-1">
                  <h3 class="text-xl font-bold text-gray-900">
                    {signup.first_name} {signup.last_name}
                  </h3>

                  <p class="text-sm text-gray-600">
                    Signed up {Calendar.strftime(signup.inserted_at, "%B %d, %Y at %I:%M %p")}
                  </p>
                </div>

                <span class={"px-3 py-1 rounded-full text-xs font-semibold #{status_color(signup.status)}"}>
                  {String.upcase(signup.status)}
                </span>
              </div>

              <div class="grid md:grid-cols-2 gap-4 mb-4">
                <div>
                  <p class="text-sm font-medium text-gray-700">Contact Information</p>

                  <p class="text-sm text-gray-600">📧 {signup.email}</p>

                  <p class="text-sm text-gray-600">📱 {signup.phone}</p>

                  <p class="text-sm text-gray-600">👤 Age: {format_age_range(signup.age_range)}</p>
                </div>

                <div>
                  <p class="text-sm font-medium text-gray-700">Emergency Contact</p>

                  <p class="text-sm text-gray-600">{signup.emergency_contact_name}</p>

                  <p class="text-sm text-gray-600">📱 {signup.emergency_contact_phone}</p>
                </div>
              </div>

              <div class="mb-4">
                <p class="text-sm font-medium text-gray-700">Experience Level</p>

                <p class="text-sm text-gray-600">{format_experience(signup.experience_level)}</p>
              </div>

              <%= if signup.medical_conditions do %>
                <div class="mb-4 bg-yellow-50 border border-yellow-200 rounded-md p-3">
                  <p class="text-sm font-medium text-gray-700">Medical Conditions / Notes</p>

                  <p class="text-sm text-gray-600">{signup.medical_conditions}</p>
                </div>
              <% end %>
              <!-- Actions -->
              <div class="flex items-center space-x-2 pt-4 border-t border-gray-200">
                <button
                  phx-click="update_status"
                  phx-value-id={signup.id}
                  phx-value-status="pending"
                  class="px-3 py-1 text-sm bg-yellow-100 text-yellow-800 rounded hover:bg-yellow-200 transition-colors"
                >
                  Mark Pending
                </button>
                <button
                  phx-click="update_status"
                  phx-value-id={signup.id}
                  phx-value-status="approved"
                  class="px-3 py-1 text-sm bg-green-100 text-green-800 rounded hover:bg-green-200 transition-colors"
                >
                  Approve
                </button>
                <button
                  phx-click="update_status"
                  phx-value-id={signup.id}
                  phx-value-status="contacted"
                  class="px-3 py-1 text-sm bg-blue-100 text-blue-800 rounded hover:bg-blue-200 transition-colors"
                >
                  Mark Contacted
                </button>
                <button
                  phx-click="delete"
                  phx-value-id={signup.id}
                  data-confirm="Are you sure you want to delete this signup?"
                  class="px-3 py-1 text-sm bg-red-100 text-red-800 rounded hover:bg-red-200 transition-colors ml-auto"
                >
                  Delete
                </button>
              </div>
            </div>
          </div>
        <% end %>
      </div>
    <% end %>
  </main>
</div>
