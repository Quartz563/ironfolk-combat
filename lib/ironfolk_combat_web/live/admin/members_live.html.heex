<.flash_group flash={@flash} />
<div class="min-h-screen bg-gray-50">
  <!-- Admin Header -->
  <header class="bg-white shadow-sm border-b-4 border-pink-500">
    <div class="container mx-auto px-4 py-4">
      <div class="flex items-center justify-between">
        <div class="flex items-center space-x-4">
          <.link navigate={~p"/admin/dashboard"} class="text-pink-600 hover:text-pink-800">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M10 19l-7-7m0 0l7-7m-7 7h18"
              >
              </path>
            </svg>
          </.link>
          <h1 class="text-2xl font-bold text-gray-900">Manage Members</h1>
        </div>

        <div class="flex items-center space-x-4">
          <.link href={~p"/admin/logout"} method="delete" class="secondary-button">Logout</.link>
        </div>
      </div>
    </div>
  </header>
  
<!-- Filters -->
  <div class="container mx-auto px-4 py-4">
    <div class="bg-white rounded-lg shadow-md p-4">
      <div class="flex items-center space-x-4">
        <span class="text-sm font-medium text-gray-700">Filter by status:</span>
        <button
          phx-click="filter"
          phx-value-status="all"
          class={"px-4 py-2 rounded-md text-sm font-medium transition-colors #{if @filter == "all", do: "bg-pink-600 text-white", else: "bg-gray-200 text-gray-700 hover:bg-gray-300"}"}
        >
          All
        </button>
        <button
          phx-click="filter"
          phx-value-status="active"
          class={"px-4 py-2 rounded-md text-sm font-medium transition-colors #{if @filter == "active", do: "bg-green-600 text-white", else: "bg-gray-200 text-gray-700 hover:bg-gray-300"}"}
        >
          Active
        </button>
        <button
          phx-click="filter"
          phx-value-status="inactive"
          class={"px-4 py-2 rounded-md text-sm font-medium transition-colors #{if @filter == "inactive", do: "bg-gray-600 text-white", else: "bg-gray-200 text-gray-700 hover:bg-gray-300"}"}
        >
          Inactive
        </button>
      </div>
    </div>
  </div>

  <main class="container mx-auto px-4 py-8">
    <%= if Enum.empty?(@members) do %>
      <div class="bg-white rounded-lg shadow-md p-12 text-center">
        <svg
          class="w-16 h-16 text-gray-400 mx-auto mb-4"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"
          >
          </path>
        </svg>
        <p class="text-gray-600 text-lg">No members yet</p>

        <p class="text-gray-500 text-sm mt-2">Approve signups to create member records</p>
      </div>
    <% else %>
      <div class="bg-white rounded-lg shadow-md overflow-hidden">
        <div class="overflow-x-auto">
          <table class="min-w-full divide-y divide-gray-200">
            <thead class="bg-gray-50">
              <tr>
                <th
                  scope="col"
                  class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider"
                >
                  Name
                </th>

                <th
                  scope="col"
                  class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider"
                >
                  IFN
                </th>

                <th
                  scope="col"
                  class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider"
                >
                  Email
                </th>

                <th
                  scope="col"
                  class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider"
                >
                  Phone
                </th>

                <th
                  scope="col"
                  class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider"
                >
                  Status
                </th>

                <th
                  scope="col"
                  class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider"
                >
                  Actions
                </th>
              </tr>
            </thead>

            <tbody class="bg-white divide-y divide-gray-200">
              <%= for member <- @members do %>
                <tr class="hover:bg-gray-50">
                  <td class="px-6 py-4 whitespace-nowrap">
                    <div class="text-sm font-medium text-gray-900">
                      {member.first_name} {member.last_name}
                    </div>
                  </td>

                  <td class="px-6 py-4 whitespace-nowrap">
                    <div class="text-sm text-gray-900 font-mono">{member.ifn}</div>
                  </td>

                  <td class="px-6 py-4 whitespace-nowrap">
                    <div class="text-sm text-gray-500">{member.email}</div>
                  </td>

                  <td class="px-6 py-4 whitespace-nowrap">
                    <div class="text-sm text-gray-500">{member.phone}</div>
                  </td>

                  <td class="px-6 py-4 whitespace-nowrap">
                    <span class={"px-2 py-1 inline-flex text-xs leading-5 font-semibold rounded-full #{status_badge_color(member.status)}"}>
                      {String.upcase(member.status)}
                    </span>
                  </td>

                  <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
                    <button
                      phx-click="view_member"
                      phx-value-id={member.id}
                      class="text-pink-600 hover:text-pink-900 mr-3"
                    >
                      View
                    </button>
                    <button
                      phx-click="edit_ifn"
                      phx-value-id={member.id}
                      class="text-blue-600 hover:text-blue-900 mr-3"
                    >
                      Edit IFN
                    </button>
                    <%= if member.status == "active" do %>
                      <button
                        phx-click="deactivate_member"
                        phx-value-id={member.id}
                        data-confirm="Are you sure you want to deactivate this member?"
                        class="text-red-600 hover:text-red-900"
                      >
                        Deactivate
                      </button>
                    <% end %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>
    <% end %>
  </main>
</div>

<!-- Member Detail Modal -->
<%= if @show_detail_modal && @selected_member do %>
  <div class="fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50 p-4">
    <div class="bg-white rounded-lg shadow-xl max-w-2xl w-full max-h-[90vh] overflow-y-auto">
      <div class="p-6">
        <div class="flex items-start justify-between mb-6">
          <h2 class="text-2xl font-bold text-gray-900">Member Details</h2>
          <button
            phx-click="close_detail_modal"
            class="text-gray-400 hover:text-gray-600"
          >
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M6 18L18 6M6 6l12 12"
              >
              </path>
            </svg>
          </button>
        </div>

        <div class="space-y-6">
          <!-- Basic Info -->
          <div class="bg-gradient-to-r from-pink-50 to-purple-50 rounded-lg p-6">
            <div class="flex items-center justify-between mb-4">
              <h3 class="text-xl font-bold text-gray-900">
                {@selected_member.first_name} {@selected_member.last_name}
              </h3>
              <span class={"px-3 py-1 rounded-full text-xs font-semibold #{status_badge_color(@selected_member.status)}"}>
                {String.upcase(@selected_member.status)}
              </span>
            </div>

            <div class="grid md:grid-cols-2 gap-4">
              <div>
                <p class="text-sm font-medium text-gray-600">Ironfolk ID Number</p>
                <p class="text-lg font-mono font-bold text-pink-600">{@selected_member.ifn}</p>
              </div>

              <div>
                <p class="text-sm font-medium text-gray-600">Membership Type</p>
                <p class="text-lg text-gray-900">
                  {String.capitalize(@selected_member.membership_type)}
                </p>
              </div>
            </div>
          </div>
          
<!-- Contact Information -->
          <div>
            <h3 class="text-lg font-semibold text-gray-900 mb-3">Contact Information</h3>
            <div class="bg-white border border-gray-200 rounded-lg p-4 space-y-2">
              <div class="flex items-center">
                <svg
                  class="w-5 h-5 text-gray-400 mr-3"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
                  >
                  </path>
                </svg>
                <span class="text-gray-700">{@selected_member.email}</span>
              </div>

              <%= if @selected_member.phone do %>
                <div class="flex items-center">
                  <svg
                    class="w-5 h-5 text-gray-400 mr-3"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"
                    >
                    </path>
                  </svg>
                  <span class="text-gray-700">{@selected_member.phone}</span>
                </div>
              <% end %>
            </div>
          </div>
          
<!-- Membership Status -->
          <div>
            <h3 class="text-lg font-semibold text-gray-900 mb-3">Membership Status</h3>
            <div class="bg-white border border-gray-200 rounded-lg p-4">
              <%= if @selected_member.membership_expires_at do %>
                <div class="flex items-center justify-between mb-2">
                  <span class="text-sm font-medium text-gray-600">Expires:</span>
                  <span class={"text-sm font-semibold #{if IronfolkCombat.Members.membership_active?(@selected_member), do: "text-green-600", else: "text-red-600"}"}>
                    {Date.to_string(@selected_member.membership_expires_at)}
                  </span>
                </div>
                <div class="flex items-center justify-between">
                  <span class="text-sm font-medium text-gray-600">Status:</span>
                  <span class={"text-sm font-semibold #{if IronfolkCombat.Members.membership_active?(@selected_member), do: "text-green-600", else: "text-red-600"}"}>
                    {if IronfolkCombat.Members.membership_active?(@selected_member),
                      do: "Active",
                      else: "Expired"}
                  </span>
                </div>
              <% else %>
                <p class="text-sm text-gray-600">No active membership</p>
              <% end %>
            </div>
          </div>
          
<!-- Timestamps -->
          <div>
            <h3 class="text-lg font-semibold text-gray-900 mb-3">Record Information</h3>
            <div class="bg-white border border-gray-200 rounded-lg p-4 space-y-2">
              <div class="flex items-center justify-between">
                <span class="text-sm text-gray-600">Member since:</span>
                <span class="text-sm text-gray-900">
                  {Calendar.strftime(@selected_member.inserted_at, "%d/%m/%Y")}
                </span>
              </div>
              <div class="flex items-center justify-between">
                <span class="text-sm text-gray-600">Last updated:</span>
                <span class="text-sm text-gray-900">
                  {Calendar.strftime(@selected_member.updated_at, "%d/%m/%Y")}
                </span>
              </div>
            </div>
          </div>
        </div>

        <div class="mt-6 flex justify-end">
          <button
            phx-click="close_detail_modal"
            class="rainbow-button"
          >
            Close
          </button>
        </div>
      </div>
    </div>
  </div>
<% end %>

<!-- Edit IFN Modal -->
<%= if @show_edit_ifn_modal && @editing_member do %>
  <div class="fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50 p-4">
    <div class="bg-white rounded-lg shadow-xl max-w-md w-full">
      <div class="p-6">
        <div class="flex items-start justify-between mb-6">
          <h2 class="text-2xl font-bold text-gray-900">Edit IFN</h2>
          <button
            phx-click="close_ifn_modal"
            class="text-gray-400 hover:text-gray-600"
          >
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M6 18L18 6M6 6l12 12"
              >
              </path>
            </svg>
          </button>
        </div>

        <div class="mb-6">
          <div class="bg-yellow-50 border border-yellow-200 rounded-lg p-4 mb-4">
            <div class="flex items-start">
              <svg
                class="w-5 h-5 text-yellow-600 mt-0.5 mr-3 flex-shrink-0"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"
                >
                </path>
              </svg>
              <div class="text-sm text-gray-700">
                <strong>Warning:</strong>
                Changing a member's IFN should only be done to correct errors. This will affect payment records and member history.
              </div>
            </div>
          </div>

          <div class="bg-white border border-gray-200 rounded-lg p-4 mb-4">
            <p class="text-sm text-gray-600 mb-2">Current IFN:</p>
            <p class="text-xl font-mono font-bold text-gray-900">{@editing_member.ifn}</p>
          </div>

          <form phx-submit="save_ifn" class="space-y-4">
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-2">
                New IFN *
              </label>
              <input
                type="text"
                name="ifn"
                value={@new_ifn}
                phx-change="update_ifn_input"
                placeholder="IFN-XXXX"
                required
                pattern="IFN-\d{4}"
                class="w-full px-4 py-3 text-lg font-mono border border-gray-300 rounded-lg shadow-sm focus:outline-none focus:ring-2 focus:ring-pink-500 focus:border-pink-500 uppercase"
              />
              <p class="mt-1 text-xs text-gray-500">Format: IFN-XXXX (e.g., IFN-0042)</p>
            </div>

            <div class="flex space-x-3">
              <button
                type="button"
                phx-click="close_ifn_modal"
                class="flex-1 secondary-button py-2"
              >
                Cancel
              </button>
              <button
                type="submit"
                class="flex-1 rainbow-button py-2"
              >
                Update IFN
              </button>
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>
<% end %>
