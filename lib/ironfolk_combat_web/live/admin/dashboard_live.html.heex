<.flash_group flash={@flash} />
<div class="min-h-screen bg-gray-50">
  <header class="bg-white shadow-sm border-b-4 border-pink-500">
    <div class="container mx-auto px-4 py-4">
      <div class="flex items-center justify-between">
        <div class="flex items-center space-x-4">
          <img src="/images/ironfolk-logo.svg" alt="Ironfolk Combat" class="h-10 w-auto" />
          <div>
            <h1 class="text-2xl font-bold text-gray-900">Admin Dashboard</h1>

            <p class="text-sm text-gray-600">Welcome back, {@current_admin.name}</p>
          </div>
        </div>

        <div class="flex items-center space-x-4">
          <.link navigate={~p"/"} class="text-sm text-gray-600 hover:text-pink-600">
            View Website
          </.link>
          <.link href={~p"/admin/logout"} method="delete" class="secondary-button">Logout</.link>
        </div>
      </div>
    </div>
  </header>
  <!-- Main Content -->
  <main class="container mx-auto px-4 py-8">
    <!-- Stats Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mb-8">
      <!-- Pending Signups -->
      <div class="bg-white rounded-lg shadow-md p-6 border-l-4 border-pink-500">
        <div class="flex items-center justify-between">
          <div>
            <p class="text-sm font-medium text-gray-600">Pending Signups</p>

            <p class="text-3xl font-bold text-gray-900">{@pending_signups_count}</p>
          </div>

          <div class="bg-pink-100 rounded-full p-3">
            <svg
              class="w-8 h-8 text-purple-600"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z"
              >
              </path>
            </svg>
          </div>
        </div>

        <.link
          navigate={~p"/admin/signups"}
          class="text-sm text-purple-600 hover:text-purple-800 mt-4 inline-block"
        >
          Manage signups →
        </.link>
      </div>
      <!-- Events -->
      <div class="bg-white rounded-lg shadow-md p-6 border-l-4 border-blue-500">
        <div class="flex items-center justify-between">
          <div>
            <p class="text-sm font-medium text-gray-600">Active Events</p>

            <p class="text-3xl font-bold text-gray-900">{@active_events_count}</p>
          </div>

          <div class="bg-blue-100 rounded-full p-3">
            <svg
              class="w-8 h-8 text-blue-600"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"
              >
              </path>
            </svg>
          </div>
        </div>

        <.link
          navigate={~p"/admin/events"}
          class="text-sm text-blue-600 hover:text-blue-800 mt-4 inline-block"
        >
          Manage events →
        </.link>
      </div>

      <div class="bg-white rounded-lg shadow-md p-6 border-l-4 border-yellow-500">
        <div class="flex items-center justify-between">
          <div>
            <p class="text-sm font-medium text-gray-600">Unpublished Posts</p>

            <p class="text-3xl font-bold text-gray-900">{@draft_posts_count}</p>
          </div>

          <div class="bg-yellow-100 rounded-full p-3">
            <svg
              class="w-8 h-8 text-yellow-600"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"
              >
              </path>
            </svg>
          </div>
        </div>

        <.link
          navigate={~p"/admin/blog"}
          class="text-sm text-yellow-600 hover:text-yellow-800 mt-4 inline-block"
        >
          Manage blog posts →
        </.link>
      </div>
    </div>
    <!-- Quick Actions -->
    <div class="bg-white rounded-lg shadow-md p-6 mb-8">
      <h2 class="text-xl font-bold text-gray-900 mb-4">Quick Actions</h2>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
        <.link navigate={~p"/admin/blog/new"} class="secondary-button text-center">
          <svg
            class="w-5 h-5 inline-block mr-2"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M12 4v16m8-8H4"
            >
            </path>
          </svg>
          New Blog Post
        </.link>
        <.link
          navigate={~p"/admin/alerts/new"}
          class="secondary-button text-center bg-yellow-500 hover:bg-yellow-600 text-white"
        >
          <svg
            class="w-5 h-5 inline-block mr-2"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"
            >
            </path>
          </svg>
          Create Alert
        </.link>
        <.link
          navigate={~p"/admin/events/new"}
          class="secondary-button text-center bg-blue-500 hover:bg-blue-600 text-white"
        >
          <svg
            class="w-5 h-5 inline-block mr-2"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M12 4v16m8-8H4"
            >
            </path>
          </svg>
          Add Event
        </.link>
        <.link
          navigate={~p"/admin/signups"}
          class="secondary-button text-center bg-gray-700 hover:bg-gray-800 text-white"
        >
          <svg
            class="w-5 h-5 inline-block mr-2"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"
            >
            </path>
          </svg>
          View Signups
        </.link>
        <.link
          navigate={~p"/admin/members"}
          class="secondary-button text-center bg-gray-700 hover:bg-green-800 text-white"
        >
          <svg
            class="w-5 h-5 inline-block mr-2"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"
            >
            </path>
          </svg>
          View Members
        </.link>
      </div>
    </div>
    <!-- Current Alert Status -->
    <div class="bg-white rounded-lg shadow-md p-6">
      <h2 class="text-xl font-bold text-gray-900 mb-4">Current Alert Status</h2>

      <%= if @active_alerts_count > 0 do %>
        <div class="bg-blue-50 border border-blue-200 rounded-lg p-4">
          <div class="flex items-start">
            <svg
              class="w-5 h-5 text-blue-600 mt-0.5 mr-3"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
              >
              </path>
            </svg>
            <div class="flex-1">
              <p class="text-sm font-medium text-gray-900">
                An alert is currently active on the homepage
              </p>

              <.link
                navigate={~p"/admin/alerts"}
                class="text-sm text-blue-600 hover:text-blue-800 mt-2 inline-block"
              >
                Manage alerts →
              </.link>
            </div>
          </div>
        </div>
      <% else %>
        <div class="bg-gray-50 border border-gray-200 rounded-lg p-4 text-center">
          <p class="text-gray-600">No active alerts</p>

          <.link
            navigate={~p"/admin/alerts/new"}
            class="text-sm text-pink-600 hover:text-pink-800 mt-2 inline-block"
          >
            Create an alert →’
          </.link>
        </div>
      <% end %>
    </div>
  </main>
</div>
