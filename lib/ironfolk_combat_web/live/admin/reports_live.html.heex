<.flash_group flash={@flash} />
<div class="min-h-screen bg-gray-50">
  <!-- Admin Header -->
  <header class="bg-white shadow-sm border-b-4 border-pink-500">
    <div class="container mx-auto px-4 py-4">
      <div class="flex items-center justify-between">
        <div class="flex items-center space-x-4">
          <.link navigate={~p"/admin/dashboard"} class="text-pink-600 hover:text-pink-800">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M10 19l-7-7m0 0l7-7m-7 7h18"
              >
              </path>
            </svg>
          </.link>
          <h1 class="text-2xl font-bold text-gray-900">Manage Misconduct Reports</h1>
        </div>

        <div class="flex items-center space-x-4">
          <.link href={~p"/admin/logout"} method="delete" class="secondary-button">Logout</.link>
        </div>
      </div>
    </div>
  </header>
  <main class="container mx-auto px-4 py-8">
    <%= if Enum.empty?(@misconduct_reports) do %>
      <div class="bg-white rounded-lg shadow-md p-12 text-center">
        <svg
          class="w-16 h-16 text-gray-400 mx-auto mb-4"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z"
          >
          </path>
        </svg>
        <p class="text-gray-600 text-lg">No reports yet</p>
        <p class="text-gray-500 text-sm mt-2">
          Direct members to the incident form to create reports
        </p>
      </div>
    <% else %>
      <div class="space-y-4">
        <%= for report <- @misconduct_reports do %>
          <div class="bg-white rounded-lg shadow-md overflow-hidden hover:shadow-lg transition-shadow">
            <div class="p-6">
              <div class="flex items-start justify-between mb-4">
                <div class="flex-1">
                    <h3 class="text-xl font-bold text-gray-900">
                        Misconduct Incident Report #{report.id}
                    </h3>
                </div>
              </div>
            </div>
          </div>
        <% end %>
      </div>
    <% end %>
  </main>
</div>
