<.flash_group flash={@flash} />
<div class="min-h-screen bg-white">
  <%!-- Hero Section --%>
  <section class="relative bg-gradient-to-br from-pink-50 to-purple-50 pt-20">
    <div class="container mx-auto px-4 py-12 lg:py-16">
      <div class="max-w-4xl mx-auto text-center">
        <h1 class="text-4xl md:text-5xl font-bold mb-4 text-gray-900">
          HEMA Events Calendar
        </h1>
        <p class="text-lg text-gray-700 mb-6">
          Stay updated with upcoming HEMA events across New Zealand
        </p>
      </div>
    </div>
    <div class="absolute bottom-0 left-0 right-0 h-1 bg-gradient-to-r from-red-400 via-yellow-400 via-green-400 via-blue-400 via-indigo-400 to-purple-400">
    </div>
  </section>

  <%!-- Calendar Container --%>
  <div class="container mx-auto px-4 py-8 max-w-7xl">
    <%!-- Calendar Header with Navigation --%>
    <div class="bg-white rounded-t-lg border-2 border-pink-200 shadow-md p-4">
      <div class="flex items-center justify-between">
        <button
          phx-click="prev_month"
          class="p-2 hover:bg-pink-50 rounded-lg transition-colors"
        >
          <svg class="w-6 h-6 text-gray-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M15 19l-7-7 7-7"
            >
            </path>
          </svg>
        </button>

        <div class="flex items-center space-x-4">
          <h2 class="text-2xl font-bold text-gray-900">{@month_name}</h2>
          <button
            phx-click="today"
            class="px-4 py-2 text-sm bg-gradient-to-r from-pink-500 to-purple-500 text-white rounded-lg hover:from-pink-600 hover:to-purple-600 transition-colors"
          >
            Today
          </button>
        </div>

        <button
          phx-click="next_month"
          class="p-2 hover:bg-pink-50 rounded-lg transition-colors"
        >
          <svg class="w-6 h-6 text-gray-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7">
            </path>
          </svg>
        </button>
      </div>
    </div>

    <%!-- Calendar Grid --%>
    <div class="bg-white border-x-2 border-pink-200 shadow-md">
      <%!-- Day Headers --%>
      <div class="grid grid-cols-7 border-b-2 border-pink-200">
        <%= for day_name <- ["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"] do %>
          <div class="p-3 text-center font-semibold text-gray-700 text-sm">
            <span class="hidden md:inline">{day_name}day</span>
            <span class="md:hidden">{day_name}</span>
          </div>
        <% end %>
      </div>

      <%!-- Calendar Days --%>
      <%= for week <- @calendar_grid do %>
        <div class="grid grid-cols-7 border-b border-gray-200">
          <%= for day <- week do %>
            <div class={"relative min-h-24 md:min-h-32 p-2 border-r border-gray-200 #{if !day.in_current_month, do: "bg-gray-50", else: ""} #{if day.is_today, do: "bg-pink-50", else: ""} hover:bg-pink-25 transition-colors"}>
              <%!-- Day Number --%>
              <div class={"text-sm font-medium mb-1 #{if !day.in_current_month, do: "text-gray-400", else: "text-gray-900"} #{if day.is_today, do: "flex items-center justify-center w-6 h-6 bg-pink-500 text-white rounded-full", else: ""}"}>
                {day.date.day}
              </div>

              <%!-- Events for this day --%>
              <%= for {event, index} <- Enum.with_index(get_events_for_date(@events, day.date)) do %>
                <%= if index < 2 do %>
                  <button
                    phx-click="select_event"
                    phx-value-id={event.id}
                    class={"w-full text-left text-xs p-1 mb-1 rounded hover:opacity-80 transition-opacity text-white truncate #{event_indicator_color(event)}"}
                    title={event.name}
                  >
                    <span class="font-medium">{event.name}</span>
                  </button>
                <% end %>
              <% end %>

              <%!-- Show "+X more" if there are more than 2 events --%>
              <%= if length(get_events_for_date(@events, day.date)) > 2 do %>
                <div class="text-xs text-gray-600 pl-1">
                  +{length(get_events_for_date(@events, day.date)) - 2} more
                </div>
              <% end %>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>

    <%!-- Calendar Footer with Legend --%>
    <div class="bg-gradient-to-r from-pink-50 to-purple-50 rounded-b-lg border-x-2 border-b-2 border-pink-200 shadow-md p-4">
      <div class="flex flex-wrap items-center justify-center gap-4 text-sm">
        <div class="flex items-center space-x-2">
          <div class="w-3 h-3 bg-pink-500 rounded"></div>
          <span class="text-gray-700">Ironfolk Event</span>
        </div>
        <div class="flex items-center space-x-2">
          <div class="w-3 h-3 bg-red-500 rounded"></div>
          <span class="text-gray-700">Tournament</span>
        </div>
        <div class="flex items-center space-x-2">
          <div class="w-3 h-3 bg-blue-500 rounded"></div>
          <span class="text-gray-700">Workshop</span>
        </div>
        <div class="flex items-center space-x-2">
          <div class="w-3 h-3 bg-green-500 rounded"></div>
          <span class="text-gray-700">Social</span>
        </div>
        <div class="flex items-center space-x-2">
          <div class="w-3 h-3 bg-purple-500 rounded"></div>
          <span class="text-gray-700">Training</span>
        </div>
        <div class="flex items-center space-x-2">
          <div class="w-3 h-3 bg-indigo-500 rounded"></div>
          <span class="text-gray-700">NZ HEMA Event</span>
        </div>
      </div>
    </div>
  </div>

  <%!-- Event Detail Modal --%>
  <%= if @selected_event do %>
    <div
      class="fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50 p-4"
      phx-click="close_modal"
    >
      <div
        class="bg-white rounded-lg shadow-xl max-w-2xl w-full max-h-[90vh] overflow-y-auto"
        phx-click={JS.exec("phx-stop-propagation")}
      >
        <div class="p-6">
          <%!-- Close Button --%>
          <div class="flex items-start justify-between mb-4">
            <h2 class="text-3xl font-bold text-gray-900 flex-1">
              {@selected_event.name}
            </h2>
            <button
              phx-click="close_modal"
              class="text-gray-400 hover:text-gray-600 transition-colors"
            >
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M6 18L18 6M6 6l12 12"
                >
                </path>
              </svg>
            </button>
          </div>

          <%!-- Event Details --%>
          <div class="space-y-4">
            <div class="flex items-center text-gray-700">
              <svg
                class="w-5 h-5 mr-3 text-pink-600"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"
                >
                </path>
              </svg>
              <span class="font-medium">{format_event_date(@selected_event)}</span>
            </div>

            <div class="flex items-center text-gray-700">
              <svg
                class="w-5 h-5 mr-3 text-pink-600"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"
                >
                </path>
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"
                >
                </path>
              </svg>
              <span>{@selected_event.location}</span>
            </div>

            <%= if @selected_event.description do %>
              <div class="pt-4 border-t border-gray-200">
                <h3 class="text-lg font-semibold text-gray-900 mb-2">Description</h3>
                <p class="text-gray-700 whitespace-pre-wrap">{@selected_event.description}</p>
              </div>
            <% end %>

            <%= if @selected_event.link do %>
              <div class="pt-4">
                <a
                  href={@selected_event.link}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center px-6 py-3 bg-gradient-to-r from-pink-500 to-purple-500 text-white font-semibold rounded-lg hover:from-pink-600 hover:to-purple-600 transition-colors"
                >
                  View Event Details
                  <svg class="w-5 h-5 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"
                    >
                    </path>
                  </svg>
                </a>
              </div>
            <% end %>
          </div>
        </div>
      </div>
    </div>
  <% end %>

  <%!-- Submit Event Section --%>
  <div class="container mx-auto px-4 py-8 max-w-7xl">
    <div class="bg-gradient-to-r from-pink-50 to-purple-50 border-2 border-pink-200 rounded-lg p-8 text-center">
      <h3 class="text-2xl font-bold text-gray-900 mb-4">Want to Submit an Event?</h3>
      <p class="text-gray-700 mb-6">
        If you're organizing a HEMA event in New Zealand and would like it featured on our calendar,
        please get in touch with us. We're always happy to support the wider HEMA community!
      </p>
      <.link navigate={~p"/contact"} class="rainbow-button inline-block">
        Contact Us
      </.link>
    </div>
  </div>
</div>
