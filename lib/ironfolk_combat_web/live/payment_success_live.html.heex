<.flash_group flash={@flash} />
<section class="relative bg-gradient-to-br from-pink-50 to-purple-50 dark:from-gray-900 dark:to-gray-800 pt-20">
  <div class="container mx-auto px-4 py-16 lg:py-24">
    <div class="max-w-4xl mx-auto text-center">
      <div class="w-20 h-20 bg-green-100 dark:bg-green-900/30 rounded-full flex items-center justify-center mx-auto mb-6">
        <svg
          class="w-10 h-10 text-green-600 dark:text-green-400"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7">
          </path>
        </svg>
      </div>

      <h1 class="text-4xl md:text-6xl font-bold mb-6 text-gray-900 dark:text-white">
        Payment Successful!
      </h1>

      <p class="text-lg md:text-xl text-gray-700 dark:text-gray-300 mb-12 max-w-2xl mx-auto">
        Thank you for your payment. Your membership has been extended.
      </p>
    </div>
  </div>

  <div class="absolute bottom-0 left-0 right-0 h-1 bg-gradient-to-r from-red-400 via-yellow-400 via-green-400 via-blue-400 via-indigo-400 to-purple-400">
  </div>
</section>

<div class="min-h-screen bg-white dark:bg-gray-900 py-12">
  <div class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="bg-gradient-to-br from-pink-50 to-purple-50 dark:from-gray-800 dark:to-gray-700 rounded-lg shadow-lg p-8">
      <h2 class="text-2xl font-bold text-gray-900 dark:text-white mb-6">Payment Details</h2>

      <div class="space-y-4 mb-6">
        <div class="flex justify-between py-2 border-b border-gray-200 dark:border-gray-700">
          <span class="text-gray-600 dark:text-gray-400">Member Name:</span>
          <span class="font-semibold text-gray-900 dark:text-white">
            {@payment.member.first_name} {@payment.member.last_name}
          </span>
        </div>

        <div class="flex justify-between py-2 border-b border-gray-200 dark:border-gray-700">
          <span class="text-gray-600 dark:text-gray-400">Ironfolk ID:</span>
          <span class="font-mono font-bold text-pink-600 dark:text-pink-400">{@payment.ifn}</span>
        </div>

        <div class="flex justify-between py-2 border-b border-gray-200 dark:border-gray-700">
          <span class="text-gray-600 dark:text-gray-400">Amount Paid:</span>
          <span class="font-semibold text-gray-900 dark:text-white">
            {IronfolkCombat.Payments.Payment.format_amount(@payment)}
          </span>
        </div>

        <div class="flex justify-between py-2 border-b border-gray-200 dark:border-gray-700">
          <span class="text-gray-600 dark:text-gray-400">Membership Period:</span>
          <span class="font-semibold text-gray-900 dark:text-white">
            {Date.to_string(@payment.period_start)} to {Date.to_string(@payment.period_end)}
          </span>
        </div>
      </div>

      <%= if @payment.receipt_url do %>
        <div class="mb-6">
          <a
            href={@payment.receipt_url}
            target="_blank"
            class="block w-full text-center rainbow-button py-3"
          >
            Download Receipt
          </a>
        </div>
      <% end %>

      <div class="bg-blue-50 dark:bg-blue-900/20 border border-blue-200 dark:border-blue-800 rounded-lg p-4 mb-6">
        <p class="text-sm text-gray-700 dark:text-gray-300">
          <strong>What's Next?</strong> <br />
          A receipt has been sent to your email. Your membership is now active until {Date.to_string(
            @payment.period_end
          )}.
          See you at training!
        </p>
      </div>

      <.link navigate={~p"/"} class="block w-full text-center secondary-button py-3">
        Return to Homepage
      </.link>
    </div>
  </div>
</div>
